# EditorConfig — Consistent coding styles across editors
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false  # Markdown trailing spaces can be significant

[*.{py,pyi}]
indent_size = 4

[*.{rs,toml}]
indent_size = 4

[*.{cpp,hpp,c,h,cc,hh}]
indent_style = space
indent_size = 4

[*.hs]
indent_size = 2

[*.lean]
indent_size = 2

[*.{v,vo}]
indent_size = 2

[*.thy]
indent_size = 2

[*.agda]
indent_size = 2

[*.jl]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[*.tex]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.cff]
indent_size = 2
